# Variables de entorno del frontend (Next.js)
# Copia este archivo a `.env` y rellena los valores segun el entorno.
# IMPORTANTE: las variables NEXT_PUBLIC_* se "hornean" en `yarn build`,
# por lo que hay que reconstruir (yarn build) cada vez que se cambian.

# --- PRODUCCION ---
NEXT_PUBLIC_API_URL=https://apiestucalia.innet.es/api
NEXT_PUBLIC_BACKEND_IMG_URL=https://apiestucalia.innet.es/storage/

# --- DESARROLLO LOCAL (descomentar y comentar las de produccion) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
# NEXT_PUBLIC_BACKEND_IMG_URL=http://localhost:8000/storage/
